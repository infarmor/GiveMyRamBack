      }
    },
    "Скачать версию %@…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download version %@…"
          }
        }
      }
    },
    "Скрыть до следующей версии": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide until the next version"
          }
        }
      }
    },
    "Событий: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events: %lld"
          }
        }
      }
    },
    "События": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events"
          }
        }
      }
    },
    "Сообщения": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages"
          }
        }
      }
    },
    "Список программ, кнопки «Пауза» и «Вернуть», журнал и настройки.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App list, Pause and Resume buttons, the log and settings."
          }
        }
      }
    },
    "Ставит на паузу программы, которыми вы давно не пользуетесь, и возвращает память и заряд батареи.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses apps you haven't used in a while and gives you back memory and battery."
          }
        }
      }
    },
    "Строка меню и система": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Menu bar and system"
          }
        }
      }
    },
    "Счётчик + RAM": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count + RAM"
          }
        }
      }
    },
    "Терминал, IDE или системная утилита — такие не трогаем.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A terminal, IDE or system utility — those are left alone."
          }
        }
      }
    },
    "Только иконка": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon only"
          }
        }
      }
    },
    "Только когда памяти мало": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only when memory is low"
          }
        }
      }
    },
    "Только при нехватке памяти": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only under memory pressure"
          }
        }
      }
    },
    "Только что запущена.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just launched."
          }
        }
      }
    },
    "Тяжёлые": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heavy"
          }
        }
      }
    },
    "Тяжёлых фоновых процессов не найдено": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No heavy background processes"
          }
        }
      }
    },
    "У вас %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have %@"
          }
        }
      }
    },
    "Умная защита": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart protection"
          }
        }
      }
    },
    "Ускорять при нехватке RAM": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed up when RAM is low"
          }
        }
      }
    },
    "Фоновая нагрузка CPU — %lld%%. Сразу на паузу ставятся программы от %lld%%.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background CPU is %1$lld%%. Apps at %2$lld%% or more are paused right away."
          }
        }
      }
    },
    "Фоновые сервисы не просыпаются сами: у них нет окна, по которому можно кликнуть. Программы, которые с ними работают (синхронизация, плагины, помощники), могут зависнуть, пока вы не нажмёте «Вернуть».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background services don't wake on their own: they have no window to click. Apps that talk to them (sync, plug-ins, helpers) may hang until you press Resume."
          }
        }
      }
    },
    "Через": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After"
          }
        }
      }
    },
    "Через Cmd+Tab, Dock, Mission Control или просто откройте программу снова.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With Cmd+Tab, the Dock, Mission Control, or just open the app again."
          }
        }
      }
    },
    "Чтобы память освобождалась без вашего участия.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So memory is freed without you lifting a finger."
          }
        }
      }
    },
    "Экономия от батареи": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery saver"
          }
        }
      }
    },
    "Это утилита без иконки в Dock. Такие программы не становятся активными, и переключением их не разбудить, поэтому автоматически они не замораживаются.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a utility without a Dock icon. Such apps never become active and can't be woken by switching, so they aren't paused automatically."
          }
        }
      }
    },
    "автопауза сервиса": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "service auto-pause"
          }
        }
      }
