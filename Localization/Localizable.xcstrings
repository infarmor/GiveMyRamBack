    "Сервисы": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Services"
          }
        }
      }
    },
    "Сервисы (%lld)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Services (%lld)"
          }
        }
      }
    },
    "Сервисы на паузе не просыпаются сами — зависящие от них программы могут зависнуть": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused services don't wake on their own — apps that depend on them may hang"
          }
        }
      }
    },
    "Сеть": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AC power"
          }
        }
      }
    },
    "Сжато": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressed"
          }
        }
