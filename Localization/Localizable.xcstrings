      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protected"
          }
        }
      }
    },
    "Вдвое быстрее в жёлтой зоне и вчетверо в красной": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twice as fast when memory is tight, four times when it's critical"
          }
        }
      }
    },
    "Вдвое сокращает паузу ожидания без зарядки": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halves the waiting time when running on battery"
          }
        }
      }
    },
