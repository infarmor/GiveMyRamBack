      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic pause"
          }
        }
      }
    },
    "Автоматически ставить на паузу неактивные программы": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically pause inactive apps"
