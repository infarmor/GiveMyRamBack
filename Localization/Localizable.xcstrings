            "state": "translated",
            "value": "Reset"
          }
        }
      }
    },
    "Свободно и кэш: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free and cache: %@"
          }
        }
      }
    },
    "Сегодня": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today"
          }
        }
      }
    },
    "Сервис на паузе (%@, %@)": {
